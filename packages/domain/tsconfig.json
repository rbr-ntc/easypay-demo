{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    // Node 22 исполняет .ts напрямую, поэтому внутри пакета импортируем с
    // расширением .ts, а tsc переписывает его в .js при сборке dist
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "composite": true,
    "types": []
  },
  "include": ["src"]
}
