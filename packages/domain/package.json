{
  "name": "@easypay/domain",
  "version": "0.2.0",
  "private": true,
  "description": "Правила предметной области без ввода-вывода: деньги, зал, кухня, роли, аллергены",
  "type": "module",
  "exports": {
    "./money": { "types": "./dist/money.d.ts", "default": "./dist/money.js" },
    "./hall": { "types": "./dist/hall.d.ts", "default": "./dist/hall.js" },
    "./kitchen": { "types": "./dist/kitchen.d.ts", "default": "./dist/kitchen.js" },
    "./roles": { "types": "./dist/roles.d.ts", "default": "./dist/roles.js" },
    "./allergens": { "types": "./dist/allergens.d.ts", "default": "./dist/allergens.js" }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@easypay/config": "*",
    "typescript": "^5.6.3"
  }
}
