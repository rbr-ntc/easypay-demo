{
  "name": "@easypay/domain",
  "version": "0.2.0",
  "private": true,
  "description": "Правила предметной области без ввода-вывода: деньги, зал, кухня, роли, аллергены",
  "type": "module",
  "exports": {
    "./money": {
      "types": "./money.d.ts",
      "default": "./money.js"
    },
    "./hall": {
      "types": "./hall.d.ts",
      "default": "./hall.js"
    },
    "./kitchen": {
